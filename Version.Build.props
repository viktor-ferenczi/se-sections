<Project>
  <PropertyGroup>
    <!-- Plugin version. Pulsar and Magnetar compile without this file, so also
         update the AssemblyVersion attributes in ClientPlugin/Plugin.cs and
         ServerPlugin/Plugin.cs -->
    <Version>1.5.1</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
  </PropertyGroup>
</Project>
